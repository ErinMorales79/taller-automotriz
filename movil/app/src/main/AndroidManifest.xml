<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AplicacionTaller"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_nombre"
        android:networkSecurityConfig="@xml/configuracion_red"
        android:supportsRtl="true"
        android:theme="@style/Theme.Taller">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.OrdenesActivity" android:exported="false" />
        <activity
            android:name=".ui.DetalleOrdenActivity"
            android:exported="false"
            android:parentActivityName=".ui.OrdenesActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
