<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Taller" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">#DBEAFE</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="colorError">@color/peligro</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Suave" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_suave</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
